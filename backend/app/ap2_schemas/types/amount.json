{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ap2-protocol.org/schemas/types/amount.json",
  "x-vendored-from": "https://github.com/google-agentic-commerce/AP2/blob/main/code/sdk/schemas/ap2/types/amount.json",
  "x-vendored-license": "Apache-2.0 (c) Google, per https://github.com/google-agentic-commerce/AP2/blob/main/LICENSE",
  "title": "Amount",
  "description": "Schema defining an Amount and Current object",
  "type": "object",
  "properties": {
    "amount": {
      "type": "integer",
      "description": "Amount in minor units, according to the ISO-4217 spec."
    },
    "currency": {
      "type": "string",
      "description": "ISO-4217 3-letter alphabetic currency code of the payment."
    }
  },
  "required": [
    "amount",
    "currency"
  ]
}
